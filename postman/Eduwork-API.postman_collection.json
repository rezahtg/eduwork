{
    "info": {
        "_postman_id": "eduwork-api-collection",
        "name": "Eduwork Platform API",
        "description": "Complete API collection for Eduwork Platform with automatic token management and comprehensive tests.\n\n## Features\n- 🔐 Automatic JWT token extraction and injection\n- ✅ Response validation tests\n- 🔄 Auto-refresh token on 401 errors\n- 📧 Email verification flow\n- 🔑 Password reset flow\n- 👤 Profile completion\n\n## Usage\n1. Import this collection and the environment file\n2. Select 'Eduwork - Local' environment\n3. Run requests in order or use the test suite\n4. Tokens are automatically managed",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Authentication",
            "item": [
                {
                    "name": "Register Student",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// Validate response",
                                    "pm.test(\"Status code is 201\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "pm.test(\"Response has success flag\", function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.success).to.be.true;",
                                    "});",
                                    "",
                                    "pm.test(\"User data is present\", function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.data).to.have.property('id');",
                                    "    pm.expect(jsonData.data).to.have.property('email');",
                                    "    pm.expect(jsonData.data.status).to.eql('PENDING_VERIFICATION');",
                                    "});",
                                    "",
                                    "// Save user data to environment",
                                    "if (pm.response.code === 201) {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.environment.set('userId', jsonData.data.id);",
                                    "    pm.environment.set('userEmail', jsonData.data.email);",
                                    "    console.log('✅ Student registered:', jsonData.data.email);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{testStudentEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"phone\": \"+6281234567890\",\n  \"role\": \"STUDENT\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        },
                        "description": "Register a new student user. Returns user details with PENDING_VERIFICATION status."
                    },
                    "response": []
                },
